# Copy this file to api/.env, edit it, then start the API from the project root:
#   uvicorn api.main:app --env-file api/.env

# Fine-tuned model: a best.pth from output/<model>/<timestamp>/ (absolute, or relative to the project root).
# Leave empty to run IMGCLS_MODEL without training: zero-shot for a CLIP backbone (our 10 categories from text
# prompts), otherwise its ImageNet classifier.
IMGCLS_CHECKPOINT=

# timm architecture. Used when IMGCLS_CHECKPOINT is empty; if both are set they must match.
# Without a checkpoint it must be a CLIP backbone listed in imgcls/zeroshot.py (e.g.
# vit_base_patch32_clip_224.datacompxl, runs zero-shot) or an ImageNet-trained model (e.g. a ..._in1k tag).
IMGCLS_MODEL=mobilenetv3_large_100.ra_in1k

# auto = GPU if available, otherwise CPU; or cuda / cpu
IMGCLS_DEVICE=auto

# number of guesses returned in top_k
IMGCLS_TOP_K=3

# /detect-video: ready-made detector (OWLv2 or OWL-ViT id from Hugging Face). Empty = the default in
# imgcls/detect.py. Downloaded on first use (about 0.6 GB) to <project>/model_cache.
IMGCLS_DETECTOR=
# minimum box score for /detect-video; empty = the detector's default
IMGCLS_DETECT_THRESHOLD=
